[Unit]
Description=Week 4 Read-Only Visitor Counter
After=network-online.target mariadb.service
Wants=network-online.target
Requires=mariadb.service

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/viikkotehtava4
EnvironmentFile=/etc/viikko4.env
ExecStart=/home/ubuntu/viikkotehtava4/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8004 app:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
